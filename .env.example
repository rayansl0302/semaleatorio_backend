# Backend (Railway em produção; local: copia para .env e preenche).
# Webhook Asaas: POST https://<RAILWAY_URL>/webhooks/asaas  |  Header: asaas-access-token
# Eventos: PAYMENT_RECEIVED, PAYMENT_CONFIRMED

NODE_ENV=development
PORT=8787

# CORS: URLs do front (obrigatório em produção). Dev: localhost/127.0.0.1 também são aceites pelo código.
ALLOWED_ORIGINS=http://127.0.0.1:5173

# Opcional: URL pública fixa (senão usa RAILWAY_PUBLIC_DOMAIN).
# BACKEND_PUBLIC_URL=https://xxx.up.railway.app

# Modo Asaas: production | sandbox (força chave API + webhook token correctos para o ambiente)
# ASAAS_ENV=production
# ASAAS_ENV=sandbox

# Chaves Asaas (pelo menos uma). Sandbox: prioriza ASAAS_API_KEY_SANDBOX.
ASAAS_API_KEY=
ASAAS_API_KEY_SANDBOX=
# ASAAS_API_KEY_PRODUCTION=

# Token do painel Asaas (≥32 caracteres). Opcional: tokens por ambiente.
ASAAS_WEBHOOK_TOKEN=
# ASAAS_WEBHOOK_TOKEN_SANDBOX=
# ASAAS_WEBHOOK_TOKEN_PRODUCTION=

# Igual a VITE_FIREBASE_PROJECT_ID no front. Opcional se FIREBASE_SERVICE_ACCOUNT_JSON tiver "project_id".
FIREBASE_PROJECT_ID=

# Obrigatório para o webhook gravar plano/destaque no Firestore (JSON de uma linha, Conta de serviço).
FIREBASE_SERVICE_ACCOUNT_JSON=

# Opcional: redirect após checkout API (POST /api/checkout)
# CHECKOUT_SUCCESS_URL=https://teu-front.com/app/perfil

# --- Riot RSO (só se usares /api/auth/riot) ---
# RIOT_RSO_CLIENT_ID=
# RIOT_RSO_CLIENT_SECRET=
# RIOT_RSO_REDIRECT_URI=https://xxx.up.railway.app/api/auth/riot/callback
# RIOT_RSO_STATE_SECRET=
# FRONTEND_APP_URL=https://teu-front.com
# RIOT_RSO_SCOPES=openid
