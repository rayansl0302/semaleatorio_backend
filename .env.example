# --- Webhook Asaas (POST) ---
# URL no painel Asaas (não uses a raiz do site do front): https://<ESTE_BACKEND_RAILWAY>/webhooks/asaas
# Header: asaas-access-token = mesmo valor que ASAAS_WEBHOOK_TOKEN (em sandbox: ASAAS_WEBHOOK_TOKEN_SANDBOX ou ASAAS_WEBHOOK_TOKEN).
# Eventos úteis: PAYMENT_RECEIVED, PAYMENT_CONFIRMED (os outros podem ficar ignorados pelo código).
# Railway injeta RAILWAY_PUBLIC_DOMAIN; opcional BACKEND_PUBLIC_URL=https://...
# Com URL pública (não localhost) o backend assume Asaas PRODUCTION — webhook só sandbox: ASAAS_ENV=sandbox

# Railway injeta PORT automaticamente; localmente pode omitir (usa 8787).
# PORT=8787

NODE_ENV=development

# Origens permitidas no CORS (frontend), separadas por vírgula. Obrigatório em produção.
# Em NODE_ENV=development o backend também aceita localhost:5173 e 127.0.0.1:5173 automaticamente.
# ALLOWED_ORIGINS=http://127.0.0.1:5173,https://semaleatorio.gg

# URL pública deste API (opcional). Na Railway costuma deduzir-se de RAILWAY_PUBLIC_DOMAIN.
# Se o hostname for localhost / 127.0.0.1 → Asaas SANDBOX; caso contrário → PRODUCTION.
# BACKEND_PUBLIC_URL=https://teu-backend.up.railway.app

# Opcional: forçar modo Asaas (ignora a regra da URL acima). Valores: sandbox | production
# ASAAS_ENV=

# Asaas — pelo menos uma chave obrigatória:
# - ASAAS_API_KEY → produção (api.asaas.com); também usada em sandbox se não houver a de baixo
# - ASAAS_API_KEY_SANDBOX → homologação (api-sandbox); tem prioridade quando o modo é sandbox
ASAAS_API_KEY=
ASAAS_API_KEY_SANDBOX=
# Opcional: só produção (se definida, produção usa esta em vez de ASAAS_API_KEY)
# ASAAS_API_KEY_PRODUCTION=

# Token do webhook (fallback). Específicos por ambiente opcionais.
ASAAS_WEBHOOK_TOKEN=
# ASAAS_WEBHOOK_TOKEN_SANDBOX=
# ASAAS_WEBHOOK_TOKEN_PRODUCTION=

# Firebase — mesmo project_id que VITE_FIREBASE_PROJECT_ID no front (só isto para validar login no checkout).
FIREBASE_PROJECT_ID=

# Opcional: JSON da conta de serviço (uma linha). Só necessário para:
# - webhook Asaas atualizar plano/destaque no Firestore
# - Riot SSO gravar perfil no Firestore
# Sem isto, o checkout Asaas continua a funcionar.
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Opcional: URL de sucesso após pagamento (máx. 255 chars no Asaas)
# CHECKOUT_SUCCESS_URL=https://semaleatorio.gg/app/perfil

# Opcional: base URL para o script do front `fetch-asaas-payment-link-urls.mjs` (callback ?pagamento=sucesso).
# Por omissão usa FRONTEND_APP_URL ou http://127.0.0.1:5173
# ASAAS_LINK_SUCCESS_URL=http://127.0.0.1:5173

# --- Riot RSO (opcional): segredos só aqui; redirect da Riot aponta para ESTE backend ---
# RIOT_RSO_CLIENT_ID=
# RIOT_RSO_CLIENT_SECRET=
# RIOT_RSO_REDIRECT_URI=http://127.0.0.1:8787/api/auth/riot/callback
# RIOT_RSO_STATE_SECRET=  # ≥32 chars aleatórios
# FRONTEND_APP_URL=http://127.0.0.1:5173
# RIOT_RSO_SCOPES=openid
